        <div id="custom_authentication" class='authentication_content custom_authentication_content'>
            <div class="icon_w">
              <img src="/res/images/doctor@3x.png" alt="">
            </div>
            <div class='authentication-wrap'>
              <div class='authentication-cont'>
              </div>
              <div class='btn-group'>
                <p class="canView">同意</p>
                <p class="noCanview">拒绝</p>
              </div>
            </div>
        </div>
        <div id="know_authentication" class='authentication_content know_authentication_content'>
            <div class="icon_w">
              <img src="/res/images/doctor@3x.png" alt="">
            </div>
            <div class='authentication-wrap'>
              <h2 style="text-align: center;margin-bottom: 30px;">知情同意书</h2>
              <div class='authentication-know-cont'>
              </div>
              <div class='btn-group'>
                <p class="knowCanView">同意</p>
                <p class="knowNoCanview">不同意并跳过</p>
              </div>
            </div>
        </div>
      </div>
      <!-- 审核中 -->
      <div id="inReview">
        <div class="title" style="padding: 48px 0 0;">工作人员正在审核中，<br />请您耐心等待</div>
        <!-- <div class="button inReviewDefine cursorPointer">确定</div> -->
      </div>
      <!-- 审核不通过 -->
      <div id="noPass">
        <div class="icon">
          <img src="https://test-image.medtrib.cn/image/post/picture/5/c44e9712-0f28-471d-bdcf-812152f96dd6.png" alt="">
        </div>
        <div class="title">
          审核未通过
        </div>
        <div class="rejectReason"></div>
        <div class="buttons">
          <!-- <div class="determine cursorPointer">确定</div> -->
          <div class="separate">
            <!-- 驳回原因插入点 -->
          </div>
          <div class="reSubmit cursorPointer">重新提交</div>
        </div>
      </div>

      <!-- 完善信息 -->
      <div id="userInfo">
        <div class="userInfoBox">
          <div class="title">
            <div class="titleText">完善信息</div>
            <div class="img">
              <img class="userInfoClose cursorPointer" src="https://test-image.medtrib.cn/image/post/picture/5/f593b4cf-d06b-4c06-bced-4bdad1d6c796.png" alt="">
            </div>
          </div>
          <!-- 功能 -->
          <div id="userInfoMain" v-loading="viewLoading">
            <div v-for="(item, index) in userInfoList" :key="index">
              <!-- 系统字段 -->
              <template v-if="item.paramType == 0">
                <!-- 姓名 email 纯文本内容 -->
                <div v-if="item.type == 1 || item.type == 4" class="infoItem textInput bottomBar">
                  <div class="itemLeft">{{ item.paramName }}</div>
                  <div class="itemRight">
                    <el-input v-model="item.paramValue" :placeholder="item.paramPlaceholder"
                      :maxlength="item.paramMaxlength"></el-input>
                  </div>
                </div>
                <!-- 性别 -->
                <div v-if="item.type == 2" class="infoItem bottomBar sexRadio">
                  <div class="itemLeft">{{ item.paramName }}</div>
                  <div class="itemRight">
                    <div class="radioItem cursorPointer" @click="userInfoList[index].paramValue = '1'">
                      <div v-if="item.paramValue == 1" class="radioSelect">
                        <div class="select"></div>
                      </div>
                      <div v-else class="radioNotSelect"></div>
                      <div class="text">男</div>
                    </div>
                    <div class="radioItem cursorPointer" @click="userInfoList[index].paramValue = '2'">
                      <div v-if="item.paramValue == 2" class="radioSelect">
                        <div class="select"></div>
                      </div>
                      <div v-else class="radioNotSelect"></div>
                      <div class="text">女</div>
                    </div>
                  </div>
                </div>
                <!-- 省市 -->
                <div v-if="item.type == 5" class="infoItem selectInput">
                  <div class="itemLeft">{{ item.paramName }}</div>
                  <div class="itemRight">
                    <el-cascader @change="val => selectChange(val, item)" v-model="item.paramId" :options="city"
                      :placeholder="item.paramPlaceholder" style="width: 202px;height: 32px;">
                    </el-cascader>
                  </div>
                </div> 
                <!-- 医院 -->
                <div v-if="item.type == 6" class="infoItem selectInput">
                  <div class="itemLeft">{{ item.paramName }}</div>
                  <div class="itemRight">
                    <el-select v-model="item.paramValue" @focus="openHospitalModalView" @change="val => selectChange([val], item)" filterable remote
                      reserve-keyword :placeholder="item.paramPlaceholder" :remote-method="remoteMethod" :loading="hospitalsLoading"
                      style="width: 202px;height: 32px;">
                      <el-option v-for="el in hospitals" :key="el.id" :label="el.hospname" :value="el.id">
                      </el-option>
                    </el-select>
                  </div>
                </div>
                <!-- 科室 -->
                <div v-if="item.type == 7" class="infoItem selectInput">
                  <div class="itemLeft">{{ item.paramName }}</div>
                  <div class="itemRight">
                    <el-select v-model="item.paramValue" @change="val => selectChange([val], item)" @focus="openDepartmentModalView"
                      :placeholder="item.paramPlaceholder" style="width: 202px;height: 32px;">
                      <el-option v-for="el in subDepartmentList" :key="el.paramId" :label="el.paramValue" :value="el.paramId">
                      </el-option>
                    </el-select>
                  </div>
                </div>
                <!-- 职称 -->
                <div v-if="item.type == 8" class="infoItem selectInput">
                  <div class="itemLeft">{{ item.paramName }}</div>
                  <div class="itemRight">
                    <el-select v-model="item.paramValue" @change="val => selectChange([val], item)" @focus="openLevelModalView"
                      :placeholder="item.paramPlaceholder" style="width: 202px;height: 32px;">
                      <el-option v-for="el in titleList" :key="el.levelId" :label="el.level" :value="el.levelId">
                      </el-option>
                    </el-select>
                  </div>
                </div>
                <!-- 上传图片 -->
                <div v-if="item.type == 11" class="infoItem imgUpload">
                  <div class="itemLeft">{{ item.paramName }}</div>
                  <div class="itemRight" style="margin-top:50px">
                    <el-upload class="avatar-uploader" action="/app/upload/upload_pic" :show-file-list="false"
                      :on-success="res => handleAvatarSuccess(index, res)">
                      <img v-if="item.paramValue" :src="item.paramValue">
                      <div v-else class="onImg">
                        <i class="el-icon-camera" style="font-size: 24px;"></i>
                        <div class="text">{{ item.paramPlaceholder }}</div>
                      </div>
                    </el-upload>
                  </div>
                </div>
              </template>
              <!-- 系统字段 -->

              <!-- 自定义字段 -->
              <template v-else-if="item.paramType == 1">
                <!-- 文本 -->
                <div v-if="item.dataType == 1" class="infoItem textInput bottomBar twoLine">
                  <div class="itemLeft">{{ item.paramName }}</div>
                  <div class="itemRight ml0">
                    <el-input v-model="item.paramValue" :placeholder="item.paramPlaceholder"
                      :maxlength="item.paramMaxlength"></el-input>
                  </div>
                </div>
                <!-- 手机号 -->
                <div v-if="item.dataType == 3" class="infoItem textInput bottomBar">
                  <div class="itemLeft">{{ item.paramName }}</div>
                  <div class="itemRight">
                    <el-input v-model="item.paramValue" :placeholder="item.paramPlaceholder"
                      @input="item.paramValue = item.paramValue.replace(/\D/g,'')" :maxlength="11"></el-input>
                  </div>
                </div>
              </template>
              <!-- 自定义字段 -->
            </div>
            <div v-for="(item, index) in questionList" :key="index">
              <div class="infoItem textInput bottomBar twoLine">
                <div class="itemLeft">{{ item.question }}</div>
                <div class="itemRight ml0">
                  <el-input v-model.trim="item.answer" placeholder="请输入..."
                  :maxlength="99"></el-input>
                </div>
              </div>
            </div>
            <div v-loading="saveLoading" class="submit cursorPointer" @click="submit">确定</div>
          </div>
        </div>
      </div>
      <!-- 收集问题 -->
      <div id="questionInfo">
        <div class="userInfoBox">
          <div class="title">
            <div class="titleText">收集问题</div>
            <div class="img">
              <img class="questionClose cursorPointer" src="https://test-image.medtrib.cn/image/post/picture/5/f593b4cf-d06b-4c06-bced-4bdad1d6c796.png" alt="">
            </div>
          </div>
          <!-- 功能 -->
          <div id="questionInfoMain">
        <div v-for="(item,index) in questionList" :key="index">
          <div class="infoItem textInput bottomBar twoLine">
            <div class="itemLeft">{{ item.question }}</div>
            <div class="itemRight ml0">
              <el-input v-model.trim="item.answer" placeholder="请输入..."
              :maxlength="99"></el-input>
            </div>
            </div>
        </div>
            <div v-loading="saveLoading" class="submit cursorPointer" @click="submit">确定</div>
          </div>
        </div>
      </div>
      <!-- 收集问题 -->
    </div>
    <input type="hidden" name="uuid" id="uuid" value="685563cd-4f7d-4d86-ab7b-fc7ca3eaf343"/>
    <input type="hidden" name="scene" id="scene" value="4"/>
    <!-- 完善信息 -->
    <div class="content cnt">
      <div class="position"></div>
      <div id="passedReminder" class="passedReminder">
        <div class="tipIcon">
          <img src="https://test-image.medtrib.cn/image/post/picture/5/08f1f2ca-fc83-4e59-b8ac-4053a7097211.png" alt="">
        </div>
        <div class="tipText">您已通过HCP身份认证和信息审核</div>
        <div class="closeBox">
          <div class="closeFlex">
            <div class="closeNum">(<div id="passedReminderNum">5</div>s)</div>
            <div class="closeIcon">
              <img src="https://test-image.medtrib.cn/image/post/picture/5/6073716f-0586-4aa5-b44b-3bc704885f06.png" alt="">
            </div>
          </div>
        </div>
      </div>
      <div class="detail">
        <div class="detail_cnt">
          <h4>创新技术引领精准治疗，复旦肿瘤胰腺外科技术获国际同行盛赞</h4>
          <div class="para">
            <span>2026-01-02</span><span>作者：论坛报岳岳</span><span>资讯</span>
          </div>
          
            <div class="label">
              <span>非原创</span>
              
              <span></span>
            </div>
          
          <div class="expertList"></div>
          <div class="w">
            <section data-role="outer" class="article135" label="edit by 135editor" style="font-size:15px;font-family:微软雅黑, Microsoft YaHei;letter-spacing:1.5px;line-height:2;"><section class="_135editor" data-tools="135编辑器" data-id="156952"><section style="margin: 10px auto;"><section style="width: 100%;height: 3px;background-color: #9ae9d2;margin-bottom: 3px;max-width:100% !important;box-sizing:border-box;" data-width="100%"></section><section style="background-color: #f3f9ff;padding: 15px;box-sizing:border-box;"><section data-autoskip="1" class="135brush" style="text-align: justify;line-height:1.75em;letter-spacing: 1.5px;font-size:14px;color:#333333;background-color: transparent;"><p style="text-align:justify;line-height: 2;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">日前，在意大利举办的第36届意大利消化外科年会上，复旦大学附属肿瘤医院院长、胰腺肿瘤多学科综合诊治团队首席专家虞先濬教授与胰腺外科副主任刘辰教授带领团队，历时3.5小时，在国际同行面前，完成一台腹腔镜胰十二指肠切除术的直播演示，赢得现场国际同行的高度认可。</span></p><p style="text-align:justify;line-height: 2;" align="justify"><br/></p><p style="text-align:justify;line-height: 2;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">最近，欧洲国际同行发来comments反馈，再次盛赞此次手术演示的规范性与熟练度：“此次手术示教不仅展示了极高的专业水准，也为参与观摩的同行提供了宝贵的学习机会与技术启发”。</span></p></section></section></section></section><p><br/></p><p style="margin-left:10px;margin-right:10px"><img data-imgfileid="100001888" data-s="300,640" src="https://image.medtrib.cn/image/post/picture//7a30d760-735b-4fc6-b469-f4453cec1388" data-type="png" style="width:auto;vertical-align:baseline;" data-ratio="2.827777777777778" data-w="1080"/></p><p><br/></p><p style="text-align:justify;margin-left: 10px; margin-right: 10px;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">第36届意大利消化外科年会于当地时间11月24日~27日在意大利米兰举办。本届年会由意大利消化外科协会主办，以 “创新技术引领精准治疗，多学科协作共促发展”为主题，吸引来自全球40余个国家和地区的2000余名消化外科领域专家、学者及临床医师参会，是2025年度国际消化外科领域极具影响力的学术交流平台。</span></p><p><br/></p><p style="text-align:center;margin-left: 10px; margin-right: 10px;" align="center"><img src="https://image.medtrib.cn/image/post/picture//c52ffd87-831c-47cc-a772-a27d98957dd9" data-s="300,640" data-type="jpeg" data-imgfileid="100001887" style="width:auto;vertical-align:baseline;" data-ratio="0.6657407407407407" data-w="1080"/></p><p style="text-align:center;margin-left: 10px; margin-right: 10px;" align="center"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 13px;">虞先濬院长（右一）领衔团队行腹腔镜胰十二指肠切除术手术演示</span></p><p><br/></p><p style="text-align:center;margin-left: 10px; margin-right: 10px;" align="center"><img src="https://image.medtrib.cn/image/post/picture//d9ff5835-6f2e-4c27-9450-95bbd8a12831" data-s="300,640" data-type="jpeg" data-imgfileid="100001890" style="width:auto;vertical-align:baseline;" data-ratio="0.6657407407407407" data-w="1080"/></p><p style="text-align:center;margin-left: 10px; margin-right: 10px;" align="center"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 13px;">刘辰教授（右一）与国外同道分享手术中关键技术核心</span></p><p><br/></p><p style="text-align:justify;margin-left: 10px; margin-right: 10px;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">胰十二指肠切除术因涉及胰腺、胆管、胃等多个重要腹腔脏器，解剖关系复杂、手术步骤繁多，且术中需精准处理血管与消化道重建，一直被业界称为外科手术领域的“珠穆朗玛峰”。</span></p><p style="margin-left:10px;margin-right:10px"><br/></p><p style="text-align:justify;margin-left: 10px; margin-right: 10px;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">虞先濬院长介绍，医院胰腺外科早在十余年前就创新并推行胰腺肿瘤手术“开放微创对半开”的发展理念，这个被誉为“珠峰”式的手术在复旦大学附属肿瘤医院早已不用“开膛破肚”。“我们只需打5个‘小洞’，利用腹腔镜器械，就能在原本开放手术才能‘腾挪’的复杂解剖空间中，精准地根治肿瘤和重建消化道系统。”虞先濬教授强调，微创技术革新的背后是胰腺外科手术团队日复一日地精进，以及诸多原创性“复肿方案”的实践与总结。</span></p><p style="margin-left:10px;margin-right:10px"><br/></p><p style="text-align:justify;margin-left: 10px; margin-right: 10px;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">手术演示开始，虞先濬院长、刘辰教授等团队成员为一位高龄的79岁十二指肠癌患者实施手术，通过实时传输的手术画面可见，团队凭借精湛的技艺，在术中能够清晰地进行精细解剖，游刃有余地完成肿瘤切除。在消化道重建环节，他们娴熟地应用“胰管-空肠黏膜双层吻合”这一关键技术，确保了胰肠吻合的可靠性与安全性。整个过程仅用时3.5小时，术中出血量控制在50毫升以内。</span></p><p><br/></p><p style="text-align:justify;margin-left: 10px; margin-right: 10px;" align="justify"><img src="https://image.medtrib.cn/image/post/picture//4f8e501c-3bd9-4e88-928f-cce851577a19" data-s="300,640" data-type="jpeg" data-imgfileid="100001889" style="width:auto;vertical-align:baseline;" data-ratio="0.6953703703703704" data-w="1080"/></p><p style="text-align:center;margin-left: 10px; margin-right: 10px;" align="center"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 13px;">胰腺外科微创手术领跑全国、齐肩先进发达国家水平</span></p><p><br/></p><p style="text-align:justify;margin-left: 10px; margin-right: 10px;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">“复旦肿瘤胰腺外科微创手术不仅实现了微创化与根治性的完美平衡，更在关键技术环节、难点问题上提出了有益于世界同行学习的‘复旦方案’。”意方朱塞佩·玛丽亚·埃托雷教授和中方陈丹磊、高松等教授观摩后高度评价，此台手术演示堪称教科书级别。术中医生对超声刀的极致丝滑驾驭、对解剖层次的精准把握，规范彻底的淋巴结清扫，以及精准牢靠的消化道重建，完美诠释了如何将腹腔镜胰十二指肠切除术中的关键难点转化为可控制的标准化步骤。这为世界胰腺外科领域提供了值得深入学习和借鉴的经验。</span></p><p><br/></p><p style="text-align:center;margin-left: 10px; margin-right: 10px;" align="center"><img src="https://image.medtrib.cn/image/post/picture//5cafa0f1-5a38-43fa-b88f-fd37c4670126" data-s="300,640" data-type="jpeg" data-imgfileid="100001893" style="width:auto;vertical-align:baseline;" data-ratio="0.6657407407407407" data-w="1080"/></p><p style="text-align:center;margin-left: 10px; margin-right: 10px;" align="center"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 13px;">国内外专家高度评价手术演示团队的精湛操作</span></p><p><br/></p><p style="text-align:justify;margin-left: 10px; margin-right: 10px;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">在虞先濬教授的引领下，复旦大学附属肿瘤医院胰腺外科已成为国际胰腺外科领域的重要力量。科室年完成胰十二指肠切除术逾千例，其中腹腔镜与机器人手术占比超过80%，展现出高度的微创化水平。尤为突出的是，在如此高手术量的基础上，涉及血管切除与重建的复杂病例比例高达20%以上，充分彰显了团队处理高难度手术的综合能力。刘辰教授创新性地提出的“中间入路腹腔镜胰十二指肠切除术”（“Leave the vein alone”理念），是该科室技术精进与理念革新的代表。该术式在确保肿瘤根治性的同时，有效减少了术中出血及相关并发症，实现了肿瘤学疗效与手术安全性的双重提升。</span></p><p style="margin-left:10px;margin-right:10px"><br/></p><p style="text-align:justify;margin-left: 10px; margin-right: 10px;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">此次受邀参与第 36 届意大利消化外科年会手术演示，不仅是国际学界对“复旦肿瘤”胰腺外科技术的认可，更标志着医院胰腺外科微创水平已经从过去的“跟跑者”逐渐成为“领跑者”。</span></p><p style="margin-left:10px;margin-right:10px"><br/></p><p style="text-align:justify;margin-left: 10px; margin-right: 10px;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">“能在国际舞台上展示中国胰腺外科技术，既是荣誉更是责任。” 虞先濬院长说，胰腺外科将持续开展临床研究与外科技术创新，同时通过国际学术交流平台，将我国胰腺外科的诊疗经验与全球同行共享，进一步提升胰腺癌外科手术精细化水平。</span></p><p><br/></p><p style="text-align:center;margin-left: 10px; margin-right: 10px;" align="center"><img src="https://image.medtrib.cn/image/post/picture//da4d42ca-f843-4223-9432-102ff2e3ef34" data-s="300,640" data-type="png" data-imgfileid="100001894" style="width:auto;vertical-align:baseline;" data-ratio="0.4861111111111111" data-w="1080"/></p><p style="text-align:center;margin-left: 10px; margin-right: 10px;" align="center"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 13px;">复旦肿瘤胰腺外科集体照</span></p><p><br/></p><p style="text-align:justify; margin-left: 10px; margin-right: 10px;" align="justify"><span style="font-weight: 400; color: #000000; text-shadow: none; letter-spacing: 1.5px; font-size: 15px;">来源：复旦大学附属肿瘤医院</span></p></section>
          </div>
          
