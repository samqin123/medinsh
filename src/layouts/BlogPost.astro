---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-height: 480px;
				overflow: hidden;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 0;
				width: 100%;
				height: 480px;
				object-fit: cover;
			}
			.prose {
				width: 780px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1.5em;
				padding-bottom: 1.5em;
				text-align: left;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2.2em;
				line-height: 1.2;
			}
			.meta {
				display: flex;
				gap: 1.5em;
				align-items: center;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.category {
				display: inline-block;
				padding: 0.2em 0.7em;
				background: var(--accent-light);
				color: var(--accent);
				border-radius: 4px;
				font-size: 0.8em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.last-updated-on {
				font-style: italic;
			}
			@media (max-width: 720px) {
				.hero-image img { height: 280px; }
				.title h1 { font-size: 1.6em; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img src={typeof heroImage === 'string' ? heroImage : heroImage.src} alt={title} />
					</div>
				)}
				<div class="prose">
					<div class="title">
						<span class="category">{category}</span>
						<h1>{title}</h1>
						<div class="meta">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<span class="last-updated-on">
									Updated <FormattedDate date={updatedDate} />
								</span>
							)}
						</div>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
