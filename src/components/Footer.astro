</footer>
<style>
	footer {
		padding: 2em 1em 3em;
		background: rgb(var(--gray-dark));
		color: rgba(255, 255, 255, 0.7);
		text-align: center;
		margin-top: 3em;
	}
	.footer-inner {
		max-width: 720px;
		margin: 0 auto;
	}
	.footer-brand {
		font-size: 1em;
		margin-bottom: 1em;
	}
	.footer-brand strong {
		color: white;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-bottom: 1em;
	}
	.footer-links a {
		color: rgba(255,255,255,0.7);
		text-decoration: none;
		font-size: 0.9em;
	}
	.footer-links a:hover {
		color: white;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 0.8em;
		margin-bottom: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgba(255,255,255,0.6);
	}
	.social-links a:hover {
		color: white;
	}
	.copyright {
		font-size: 0.8em;
		color: rgba(255,255,255,0.4);
		margin: 0;
	}
</style>
