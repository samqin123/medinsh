---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/"><img src="/images/logo.png" alt="MedInSh" class="logo-img" /></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/hospitals">Hospitals</HeaderLink>
			<HeaderLink href="/doctors">Surgeons</HeaderLink>
			<HeaderLink href="/research">Research</HeaderLink>
			<HeaderLink href="/clinical-trials">Clinical Trials</HeaderLink>
			<HeaderLink href="/blog">Insights</HeaderLink>
			<HeaderLink href="/medical-travel">Medical Travel</HeaderLink>
			<HeaderLink href="/insurance">Insurance</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://facebook.com/" target="_blank" rel="noopener">
				<span class="sr-only">Facebook</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28"><path fill="currentColor" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
			</a>
			<a href="https://x.com/" target="_blank" rel="noopener">
				<span class="sr-only">X (Twitter)</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
			</a>
			<a href="https://t.me/medinsh01" target="_blank" rel="noopener">
				<span class="sr-only">Telegram</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28"><path fill="currentColor" d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		display: flex;
		align-items: center;
	}
	.logo-img {
		display: block;
		width: clamp(56px, 5vw, 74px);
		height: auto;
		max-height: 74px;
		object-fit: contain;
		border-radius: 6px;
		flex-shrink: 0;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: nowrap;
	}
	.internal-links {
		display: flex;
		flex: 1 1 auto;
		justify-content: center;
		gap: 1rem;
		min-width: 0;
		flex-wrap: nowrap;
		overflow: hidden;
	}
	.internal-links :global(a) {
		white-space: nowrap;
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	@media (max-width: 1150px) {
		nav {
			flex-wrap: wrap;
		}
		.internal-links {
			order: 3;
			width: 100%;
			justify-content: flex-start;
			overflow-x: auto;
			padding-bottom: 0.25rem;
		}
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		.internal-links {
			display: none;
		}
		h2 a {
			padding: 0.5rem 0;
		}
	}
</style>
