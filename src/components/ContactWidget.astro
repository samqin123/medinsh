					</div>
				</div>
			</div>
		</div>
	</div>
)}

<style>
	.contact-widget {
		position: fixed;
		right: 0;
		bottom: 3rem;
		z-index: 50;
		display: flex;
		align-items: stretch;
		background: rgba(255, 255, 255, 0.95);
		border: 1px solid rgba(226, 232, 240, 0.8);
		border-right: 0;
		border-radius: 24px 0 0 24px;
		box-shadow: -8px 8px 30px rgba(0, 0, 0, 0.08);
		backdrop-filter: blur(12px);
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.contact-widget.is-collapsed {
		transform: translateX(calc(100% - 2rem));
	}

	.contact-toggle {
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		padding: 0;
		color: #94a3b8;
		background: transparent;
		border: 0;
		border-right: 1px solid #f1f5f9;
		border-radius: 24px 0 0 24px;
		cursor: pointer;
		transition: color 0.2s, background 0.2s;
	}

	.contact-toggle:hover {
		color: var(--accent);
		background: rgba(248, 250, 252, 0.8);
	}

	.contact-toggle-icon {
		width: 1rem;
		height: 1rem;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.contact-widget.is-collapsed .contact-toggle-icon {
		transform: rotate(180deg);
	}

	.contact-panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: max-content;
		padding: 0.75rem 1rem;
	}

	.contact-label {
		margin-bottom: 0.625rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #94a3b8;
		text-transform: uppercase;
	}

	.contact-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.contact-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 999px;
		box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
		cursor: pointer;
		transition: background 0.2s, transform 0.2s;
	}

	.contact-link:hover {
		transform: translateY(-1px);
	}

	.contact-icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	.whatsapp {
		color: #25d366;
		background: rgba(37, 211, 102, 0.1);
	}

	.whatsapp:hover {
		background: rgba(37, 211, 102, 0.2);
	}

	.telegram {
		color: #0088cc;
		background: rgba(0, 136, 204, 0.1);
	}

	.telegram:hover {
		background: rgba(0, 136, 204, 0.2);
	}

	.x-link {
		color: #0f172a;
		background: rgba(15, 23, 42, 0.08);
	}

	.x-link:hover {
		background: rgba(15, 23, 42, 0.16);
	}

	.facebook {
		color: #1877f2;
		background: rgba(24, 119, 242, 0.1);
	}

	.facebook:hover {
		background: rgba(24, 119, 242, 0.2);
	}

	.wechat {
		color: #07c160;
		background: rgba(7, 193, 96, 0.1);
	}

	.wechat:hover {
		background: rgba(7, 193, 96, 0.2);
	}

	.wechat-wrap {
		position: relative;
	}

	.wechat-popover {
		position: absolute;
		right: 0;
		bottom: calc(100% + 1rem);
		width: 9rem;
		padding: 0.5rem;
		text-align: center;
		pointer-events: none;
		background: white;
		border: 1px solid #f1f5f9;
		border-radius: 16px;
		box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18);
		opacity: 0;
		transform: scale(0.95);
		transform-origin: bottom right;
		transition: opacity 0.2s, transform 0.2s;
	}

	.wechat-wrap:hover .wechat-popover,
	.wechat-wrap:focus-within .wechat-popover {
		opacity: 1;
		transform: scale(1);
	}

	.wechat-popover img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid #f1f5f9;
		border-radius: 8px;
		background: #f8fafc;
	}

	@media (max-width: 720px) {
		.contact-widget {
			bottom: 1.25rem;
		}
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const widget = document.getElementById('contact-widget');
		const toggle = document.getElementById('contact-toggle-btn');
		if (!widget || !toggle) return;

		toggle.addEventListener('click', () => {
			const isCollapsed = widget.classList.toggle('is-collapsed');
			toggle.setAttribute('aria-expanded', String(!isCollapsed));
			toggle.setAttribute('aria-label', isCollapsed ? 'Expand contact widget' : 'Collapse contact widget');
		});
	});
</script>
