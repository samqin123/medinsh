---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Pancreatic Cancer Oncologists in Shanghai | MedInSh"
			description="Meet Shanghai's leading pancreatic cancer medical oncologists — chemotherapy, targeted therapy, immunotherapy, and clinical trials."
		/>
		<style>
			.page-header {
				text-align: center;
				padding: 3em 0 2em;
				border-bottom: 1px solid rgb(var(--gray-light));
				margin-bottom: 2.5em;
			}
			.page-header h1 { font-size: 2.2em; margin-bottom: 0.3em; }
			.page-header p { color: rgb(var(--gray)); font-size: 1.05em; margin: 0; max-width: 660px; margin-left: auto; margin-right: auto; }

			.hospital-group { margin-bottom: 3.5em; }
			.hospital-group-header {
				display: flex;
				align-items: center;
				gap: 0.8em;
				margin-bottom: 1.5em;
				padding-bottom: 0.5em;
				border-bottom: 2px solid var(--accent);
			}
			.hospital-group-header h2 { margin: 0; font-size: 1.5em; }
			.hospital-group-header .hospital-cn { color: rgb(var(--gray)); font-size: 0.95em; }

			.doctor-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5em;
			}
			.doctor-card {
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 1.5em;
				display: flex;
				gap: 1.2em;
				transition: box-shadow 0.2s;
			}
			.doctor-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.06); }

			.doctor-photo { flex-shrink: 0; width: 90px; }
			.doctor-photo img {
				width: 90px;
				height: 110px;
				object-fit: cover;
				border-radius: 8px;
				display: block;
			}
			.photo-placeholder {
				width: 90px;
				height: 110px;
				border-radius: 8px;
				background: linear-gradient(135deg, #ede9fe, #f3e8ff);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 2em;
				color: #6d28d9;
				opacity: 0.5;
			}

			.doctor-info h4 { margin: 0 0 0.1em; font-size: 1.05em; }
			.doctor-info .cn-name { font-size: 0.85em; color: rgb(var(--gray)); margin: 0 0 0.3em; }
			.doctor-info .title-line { font-size: 0.82em; color: rgb(var(--gray-dark)); margin: 0 0 0.4em; font-weight: 500; }
			.doctor-info .specialty { font-size: 0.82em; color: rgb(var(--gray)); margin: 0; line-height: 1.5; }
			.doctor-info .highlight { font-size: 0.78em; color: #6d28d9; margin: 0.3em 0 0; font-weight: 600; }

			.disclaimer {
				margin-top: 3em;
				padding-top: 2em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.85em;
				color: rgb(var(--gray));
				line-height: 1.6;
			}

			@media (max-width: 720px) {
				.doctor-grid { grid-template-columns: 1fr; }
				.doctor-card { flex-direction: column; align-items: center; text-align: center; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Pancreatic Cancer Oncologists</h1>
				<p>Shanghai's leading medical oncologists specializing in pancreatic cancer — chemotherapy, targeted therapy, immunotherapy, and clinical trials.</p>
			</div>

			<!-- Fudan Cancer Center -->
			<div class="hospital-group">
				<div class="hospital-group-header">
					<h2>Fudan University Shanghai Cancer Center</h2>
					<span class="hospital-cn">复旦大学附属肿瘤医院</span>
				</div>
				<div class="doctor-grid">
					<div class="doctor-card">
						<div class="doctor-photo">
							<img src="/images/dr-gao-heli.jpg" alt="Dr. Gao Heli" />
						</div>
						<div class="doctor-info">
							<h4>Dr. Heli Gao</h4>
							<p class="cn-name">高鹤丽</p>
							<p class="title-line">Pancreatic Surgery / PanNET Center · Fudan University Shanghai Cancer Center</p>
							<p class="specialty">Pancreatic neuroendocrine tumor (PanNET) research. Uncovered the ACSS2/BCL6/P53 axis mediating chemotherapy resistance — a potential therapeutic target for overcoming PanNET drug resistance.</p>
							<p class="highlight">PMID: 41786280 · Cancer Letters 2026</p>
						</div>
					</div>
					<div class="doctor-card">
						<div class="doctor-photo">
							<div class="photo-placeholder">👩‍⚕️</div>
						</div>
						<div class="doctor-info">
							<h4>Dr. Miaoyan Wei</h4>
							<p class="cn-name">魏妙艳</p>
							<p class="title-line">Pancreatic Surgery / PanNET Center · Fudan University Shanghai Cancer Center</p>
							<p class="specialty">Epigenetic regulation and drug resistance in pancreatic neuroendocrine tumors. Research on targeting ACSS2 to overcome temozolomide resistance, and SIRT7 inhibition to overcome radiotherapy resistance in PanNETs.</p>
							<p class="highlight">PMID: 41786280 · PMID: 41972414 · Active conference presenter</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Ruijin Hospital -->
			<div class="hospital-group">
				<div class="hospital-group-header">
					<h2>Ruijin Hospital</h2>
					<span class="hospital-cn">上海交通大学医学院附属瑞金医院</span>
				</div>
				<div class="doctor-grid">
					<div class="doctor-card">
						<div class="doctor-photo">
							<div class="photo-placeholder">👨‍⚕️</div>
						</div>
						<div class="doctor-info">
							<h4>Dr. Xinjing Wang</h4>
							<p class="cn-name">王新景</p>
							<p class="title-line">General Surgery / Pancreatic Disease Center · Ruijin Hospital</p>
							<p class="specialty">Pancreatic disease research at Shanghai Key Laboratory of Pancreatic Cancer Translational Research. Research on MEN1 gene mutations in insulinomas and functional characterization.</p>
							<p class="highlight">PMID: 41936330 · Cancer Genetics 2026</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Changhai Hospital -->
			<div class="hospital-group">
				<div class="hospital-group-header">
					<h2>Changhai Hospital</h2>
					<span class="hospital-cn">海军军医大学附属长海医院</span>
				</div>
				<div class="doctor-grid">
					<div class="doctor-card">
						<div class="doctor-photo">
							<div class="photo-placeholder">👨‍⚕️</div>
						</div>
						<div class="doctor-info">
							<h4>Dr. Shiwei Guo</h4>
							<p class="cn-name">郭世伟</p>
							<p class="title-line">Hepatobiliary & Pancreatic Surgery · Changhai Hospital, Naval Medical University</p>
							<p class="specialty">Co-leader of the world's first KRAS G12V-targeted TCR-T cell gene therapy clinical trial for pancreatic cancer. Collaboration with Providence Cancer Institute (Eric Tran), USA.</p>
							<p class="highlight">PMID: 41814655 · Molecular Therapy 2026 · First-in-human TCR-T</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Zhongshan Hospital -->
			<div class="hospital-group">
				<div class="hospital-group-header">
					<h2>Zhongshan Hospital</h2>
					<span class="hospital-cn">复旦大学附属中山医院</span>
				</div>
				<div class="doctor-grid">
					<div class="doctor-card">
						<div class="doctor-photo">
							<div class="photo-placeholder">👨‍⚕️</div>
						</div>
						<div class="doctor-info">
							<h4>Dr. Wenquan Wang</h4>
							<p class="cn-name">王文权</p>
							<p class="title-line">Pancreatic Surgery · Zhongshan Hospital, Fudan University</p>
							<p class="specialty">Pancreatic cancer research collaborator. Part of the multi-center proteogenomic study building deep-learning prognostic models from 873 surgical specimens.</p>
							<p class="highlight">PMID: 41556438 · Advanced Science 2026</p>
						</div>
					</div>
				</div>
			</div>

			<div class="disclaimer">
				<p>
					<strong>Disclaimer:</strong> Doctor profiles are based on publicly available information from hospital
					websites, published literature, and professional society records. MedInSh is not affiliated with any
					hospital or physician. All information is subject to change — verify directly with the hospital's
					international department before making treatment decisions. This website does not constitute medical advice.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
