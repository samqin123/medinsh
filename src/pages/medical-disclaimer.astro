---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Medical Disclaimer — MedInSh"
			description="MedInSh provides informational content and case navigation support, not medical advice."
		/>
		<style>
			.content {
				max-width: 760px;
				margin: 0 auto;
				padding: 3rem 0;
				line-height: 1.7;
			}
			.card {
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
			}
			h1 { margin-top: 0; }
		</style>
	</head>
	<body>
		<Header />
		<main class="content">
			<section class="card">
				<h1>Medical Disclaimer</h1>
				<p>MedInSh publishes educational content and helps organize case information for international patients considering treatment in Shanghai.</p>
				<p>We do not provide medical diagnosis, treatment recommendations, or emergency care. All clinical decisions must be made with a licensed physician.</p>
				<p>If you are experiencing a medical emergency, contact local emergency services immediately.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
