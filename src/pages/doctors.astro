---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Our Team — Pancreatic Cancer Specialists in Shanghai | MedInSh"
			description="Meet Shanghai's leading pancreatic cancer surgeons and oncologists at Fudan Cancer Center, Ruijin Hospital, Zhongshan Hospital, and Changhai Hospital."
		/>
		<style>
			.page-header {
				text-align: center;
				padding: 3em 0 2em;
				margin-bottom: 2.5em;
			}
			.page-header h1 { font-size: 2.4em; margin-bottom: 0.4em; }
			.page-header p { color: rgb(var(--gray)); font-size: 1.05em; margin: 0; max-width: 660px; margin-left: auto; margin-right: auto; }

			.cards-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2em;
				max-width: 800px;
				margin: 0 auto 3em;
			}
			.link-card {
				display: block;
				background: white;
				border: 2px solid rgb(var(--gray-light));
				border-radius: 14px;
				padding: 2.5em 2em;
				text-align: center;
				text-decoration: none;
				color: inherit;
				transition: box-shadow 0.2s, transform 0.15s, border-color 0.2s;
			}
			.link-card:hover {
				box-shadow: 0 10px 30px rgba(0,0,0,0.08);
				transform: translateY(-4px);
				border-color: var(--accent);
			}
			.link-card .icon {
				font-size: 3em;
				margin-bottom: 0.4em;
			}
			.link-card h2 {
				margin: 0 0 0.3em;
				font-size: 1.5em;
			}
			.link-card .count {
				display: inline-block;
				padding: 0.2em 0.7em;
				border-radius: 4px;
				font-size: 0.75em;
				font-weight: 700;
				margin-bottom: 0.6em;
			}
			.count-surgeon { background: #dbeafe; color: #1e40af; }
			.count-oncologist { background: #ede9fe; color: #6d28d9; }
			.link-card p {
				font-size: 0.9em;
				color: rgb(var(--gray));
				margin: 0;
				line-height: 1.5;
			}
			.link-card .arrow {
				display: block;
				margin-top: 1em;
				font-weight: 700;
				color: var(--accent);
				font-size: 0.95em;
			}

			/* Hospital logos row */
			.hospital-logos {
				text-align: center;
				margin-top: 2em;
				padding-top: 2em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.hospital-logos h3 {
				font-size: 0.9em;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.08em;
				margin-bottom: 1em;
			}
			.hospital-logos .logos {
				display: flex;
				justify-content: center;
				gap: 2em;
				flex-wrap: wrap;
			}
			.hospital-logos .logos span {
				font-size: 0.9em;
				color: rgb(var(--gray-dark));
				font-weight: 600;
			}

			@media (max-width: 720px) {
				.cards-grid { grid-template-columns: 1fr; }
				.page-header h1 { font-size: 1.8em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Our Team</h1>
				<p>Shanghai's top pancreatic cancer specialists across four major hospitals — surgeons performing 400+ procedures per year and oncologists leading clinical trials.</p>
			</div>

			<div class="cards-grid">
				<a href="/surgeons" class="link-card">
					<div class="icon">🏥</div>
					<h2>Surgeons</h2>
					<span class="count count-surgeon">8 Specialists</span>
					<p>
						Robotic and laparoscopic pancreatic surgery pioneers. Performing 2,000+ complex pancreatic procedures
						per year across four hospitals. International training at Johns Hopkins, Paul Brousse, and Strasbourg.
					</p>
					<span class="arrow">Meet the surgeons →</span>
				</a>
				<a href="/oncologists" class="link-card">
					<div class="icon">🧬</div>
					<h2>Oncologists</h2>
					<span class="count count-oncologist">5 Specialists</span>
					<p>
						Medical oncologists managing chemotherapy, targeted therapy, and immunotherapy. Leading clinical trials
						for KRAS inhibitors, mRNA vaccines, and TCR-T cell therapy.
					</p>
					<span class="arrow">Meet the oncologists →</span>
				</a>
			</div>

			<div class="hospital-logos">
				<h3>Hospitals Represented</h3>
				<div class="logos">
					<span>Fudan Cancer Center 复旦肿瘤</span>
					<span>Ruijin Hospital 瑞金</span>
					<span>Changhai Hospital 长海</span>
					<span>Zhongshan Hospital 中山</span>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
