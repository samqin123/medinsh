---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Pancreatic Cancer Surgeons in Shanghai | MedInSh"
			description="Meet Shanghai's leading pancreatic cancer surgeons at Fudan Cancer Center, Ruijin Hospital, Zhongshan Hospital, and Changhai Hospital."
		/>
		<style>
			.page-header {
				text-align: center;
				padding: 3em 0 2em;
				border-bottom: 1px solid rgb(var(--gray-light));
				margin-bottom: 2.5em;
			}
			.page-header h1 { font-size: 2.2em; margin-bottom: 0.3em; }
			.page-header p { color: rgb(var(--gray)); font-size: 1.05em; margin: 0; max-width: 660px; margin-left: auto; margin-right: auto; }

			.hospital-group { margin-bottom: 3.5em; }
			.hospital-group-header {
				display: flex;
				align-items: center;
				gap: 0.8em;
				margin-bottom: 1.5em;
				padding-bottom: 0.5em;
				border-bottom: 2px solid var(--accent);
			}
			.hospital-group-header h2 { margin: 0; font-size: 1.5em; }
			.hospital-group-header .hospital-cn { color: rgb(var(--gray)); font-size: 0.95em; }

			.doctor-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5em;
			}
			.doctor-card {
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 1.5em;
				display: flex;
				gap: 1.2em;
				transition: box-shadow 0.2s;
			}
			.doctor-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.06); }

			.doctor-photo { flex-shrink: 0; width: 90px; }
			.doctor-photo img {
				width: 90px;
				height: 110px;
				object-fit: cover;
				border-radius: 8px;
				display: block;
			}
			.photo-placeholder {
				width: 90px;
				height: 110px;
				border-radius: 8px;
				background: linear-gradient(135deg, var(--accent-light), #e0f2fe);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 2em;
				color: var(--accent);
				opacity: 0.5;
			}

			.doctor-info h4 { margin: 0 0 0.1em; font-size: 1.05em; }
			.doctor-info .cn-name { font-size: 0.85em; color: rgb(var(--gray)); margin: 0 0 0.3em; }
			.doctor-info .title-line { font-size: 0.82em; color: rgb(var(--gray-dark)); margin: 0 0 0.4em; font-weight: 500; }
			.doctor-info .specialty { font-size: 0.82em; color: rgb(var(--gray)); margin: 0; line-height: 1.5; }
			.doctor-info .highlight { font-size: 0.78em; color: var(--accent-dark); margin: 0.3em 0 0; font-weight: 600; }

			.disclaimer {
				margin-top: 3em;
				padding-top: 2em;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.85em;
				color: rgb(var(--gray));
				line-height: 1.6;
			}

			@media (max-width: 720px) {
				.doctor-grid { grid-template-columns: 1fr; }
				.doctor-card { flex-direction: column; align-items: center; text-align: center; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Pancreatic Cancer Surgeons</h1>
				<p>Shanghai's top pancreatic cancer surgeons — high volume, internationally trained, pioneering minimally invasive techniques.</p>
			</div>

			<!-- Fudan Cancer Center -->
			<div class="hospital-group">
				<div class="hospital-group-header">
					<h2>Fudan University Shanghai Cancer Center</h2>
					<span class="hospital-cn">复旦大学附属肿瘤医院</span>
				</div>
				<div class="doctor-grid">
					<div class="doctor-card">
						<div class="doctor-photo">
							<img src="/images/dr-xu-xiaowu.jpg" alt="Dr. Xu Xiaowu" />
						</div>
						<div class="doctor-info">
							<h4>Dr. Xiaowu Xu</h4>
							<p class="cn-name">徐晓武</p>
							<p class="title-line">Chief Physician · Vice Director, Pancreatic Surgery · PhD Supervisor</p>
							<p class="specialty">Robotic and laparoscopic minimally invasive pancreatic surgery. Pioneer in function-preserving procedures including spleen-preserving distal pancreatectomy and pancreatic tumor enucleation.</p>
							<p class="highlight">400+ pancreatic surgeries/year · 80%+ minimally invasive · NSFC grant recipient</p>
						</div>
					</div>
					<div class="doctor-card">
						<div class="doctor-photo">
							<img src="/images/dr-liu-chen.jpg" alt="Dr. Liu Chen" />
						</div>
						<div class="doctor-info">
							<h4>Dr. Chen Liu</h4>
							<p class="cn-name">刘辰</p>
							<p class="title-line">Chief Physician · Pancreatic Surgery · Professor</p>
							<p class="specialty">Innovator of "middle approach" laparoscopic Whipple — "Leave the Vein Alone" concept. Live surgery demonstrator at the 36th Italian Digestive Surgery Congress (Milan, 2025), earning "textbook-level" international praise.</p>
							<p class="highlight">Reduced blood loss · Standardized complex steps · PMID: 36690522</p>
						</div>
					</div>
					<div class="doctor-card">
						<div class="doctor-photo">
							<img src="/images/dr-xu-jin.jpg" alt="Dr. Xu Jin" />
						</div>
						<div class="doctor-info">
							<h4>Dr. Jin Xu</h4>
							<p class="cn-name">徐近</p>
							<p class="title-line">Pancreatic Surgery · Fudan University Shanghai Cancer Center</p>
							<p class="specialty">Pancreatic surgical oncology. Contributor to mitochondria DNA mutation research in pancreatic cancer (PMID: 41639740).</p>
						</div>
					</div>
					<div class="doctor-card">
						<div class="doctor-photo">
							<div class="photo-placeholder">👨‍⚕️</div>
						</div>
						<div class="doctor-info">
							<h4>Dr. Liang Liu</h4>
							<p class="cn-name">刘亮</p>
							<p class="title-line">Pancreatic Surgery · Fudan University Shanghai Cancer Center</p>
							<p class="specialty">Pancreatic surgical oncology with expertise in complex resection and MDT coordination.</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Ruijin Hospital -->
			<div class="hospital-group">
				<div class="hospital-group-header">
					<h2>Ruijin Hospital</h2>
					<span class="hospital-cn">上海交通大学医学院附属瑞金医院</span>
				</div>
				<div class="doctor-grid">
					<div class="doctor-card">
						<div class="doctor-photo">
							<img src="/images/dr-jin-jiabin.jpg" alt="Dr. Jin Jiabin" />
						</div>
						<div class="doctor-info">
							<h4>Dr. Jiabin Jin</h4>
							<p class="cn-name">金佳斌</p>
							<p class="title-line">Chief Physician · Director, Pancreatic Surgery Ward 2 · VP, Ruijin Hainan Hospital</p>
							<p class="specialty">Robotic pancreatic surgery pioneer. Trained at Paul Brousse Hospital (Paris), Strasbourg Civil Hospital, and Johns Hopkins. Author of landmark JAMA Surgery study comparing robotic vs open Whipple procedures over 10 years.</p>
							<p class="highlight">3,000+ robotic pancreatic surgeries · JAMA Surgery publication · Spleen-preserving technique pioneer</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Changhai Hospital -->
			<div class="hospital-group">
				<div class="hospital-group-header">
					<h2>Changhai Hospital</h2>
					<span class="hospital-cn">海军军医大学附属长海医院</span>
				</div>
				<div class="doctor-grid">
					<div class="doctor-card">
						<div class="doctor-photo">
							<img src="/images/dr-jin-gang.jpg" alt="Dr. Jin Gang" />
						</div>
						<div class="doctor-info">
							<h4>Dr. Gang Jin</h4>
							<p class="cn-name">金刚</p>
							<p class="title-line">Hepatobiliary & Pancreatic Surgery · Changhai Hospital, Naval Medical University</p>
							<p class="specialty">Leader of the world's first KRAS G12V-targeted TCR-T cell gene therapy clinical trial for recurrent pancreatic cancer (Molecular Therapy 2026). Collaboration with Providence Cancer Institute, USA.</p>
							<p class="highlight">PMID: 41814655 · First-in-human TCR-T for KRAS G12V pancreatic cancer</p>
						</div>
					</div>
					<div class="doctor-card">
						<div class="doctor-photo">
							<img src="/images/dr-long-jiang.jpg" alt="Dr. Long Jiang" />
						</div>
						<div class="doctor-info">
							<h4>Dr. Jiang Long</h4>
							<p class="cn-name">龙江</p>
							<p class="title-line">Pancreatic Surgery · Shanghai</p>
							<p class="specialty">Pancreatic surgical oncology.</p>
						</div>
					</div>
				</div>
			</div>

			<div class="disclaimer">
				<p>
					<strong>Disclaimer:</strong> Doctor profiles are based on publicly available information from hospital
					websites, published literature, and professional society records. MedInSh is not affiliated with any
					hospital or physician. All information is subject to change — verify directly with the hospital's
					international department before making treatment decisions. This website does not constitute medical advice.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
