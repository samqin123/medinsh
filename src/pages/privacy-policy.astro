---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Privacy Policy — MedInSh"
			description="How MedInSh handles information submitted through contact or case review forms."
		/>
		<style>
			.content {
				max-width: 760px;
				margin: 0 auto;
				padding: 3rem 0;
				line-height: 1.7;
			}
			.card {
				background: white;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
			}
			h1 { margin-top: 0; }
		</style>
	</head>
	<body>
		<Header />
		<main class="content">
			<section class="card">
				<h1>Privacy Policy</h1>
				<p>We collect only the information you choose to submit when contacting us or requesting a case review.</p>
				<p>We use that information to respond to your inquiry, prepare case organization materials, and coordinate next steps.</p>
				<p>We do not sell your personal information.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
