---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Guides — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
			}
			.page-header {
				text-align: center;
				padding: 2em 0 1em;
				border-bottom: 1px solid rgb(var(--gray-light));
				margin-bottom: 2em;
			}
			.page-header h1 {
				font-size: 2.2em;
				margin-bottom: 0.3em;
			}
			.page-header p {
				color: rgb(var(--gray));
				font-size: 1.05em;
				margin: 0;
			}
			ul {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li:first-child {
				grid-column: 1 / -1;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			.card {
				display: block;
				background: white;
				border-radius: 10px;
				overflow: hidden;
				border: 1px solid rgb(var(--gray-light));
				transition: box-shadow 0.2s, transform 0.15s;
			}
			.card:hover {
				box-shadow: 0 8px 24px rgba(0,0,0,0.08);
				transform: translateY(-3px);
			}
			.card img {
				width: 100%;
				height: 200px;
				object-fit: cover;
				border-radius: 0;
				display: block;
			}
			ul li:first-child .card img {
				height: 360px;
			}
			.card-body {
				padding: 1.2em 1.4em;
			}
			.card-tag {
				display: inline-block;
				padding: 0.15em 0.6em;
				background: var(--accent-light);
				color: var(--accent);
				border-radius: 3px;
				font-size: 0.75em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 0.5em;
			}
			.title {
				margin: 0 0 0.4em 0;
				color: rgb(var(--black));
				font-size: 1.15em;
				line-height: 1.3;
			}
			ul li:first-child .title {
				font-size: 1.6em;
			}
			.desc {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin: 0 0 0.5em;
				line-height: 1.5;
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.8em;
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
				}
				ul li:first-child .card img {
					height: 220px;
				}
				ul li:first-child .title {
					font-size: 1.3em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Patient Guides</h1>
				<p>Evidence-based guides for international patients considering treatment in Shanghai.</p>
			</div>
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="card">
							{post.data.heroImage && (
								<img src={post.data.heroImage} alt={post.data.title} />
							)}
							<div class="card-body">
								<span class="card-tag">Guide</span>
								<h4 class="title">{post.data.title}</h4>
								<p class="desc">{post.data.description}</p>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
