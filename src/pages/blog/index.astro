---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = ['All', 'Clinical Trials', 'Patient Guides', 'Research', 'News'];
---

<!doctype html>
<html lang="en">

	<head>
		<BaseHead title={`Insights — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 900px;
				max-width: calc(100% - 2em);
			}
			.page-header {
				text-align: center;
				padding: 2em 0 1em;
				border-bottom: 1px solid rgb(var(--gray-light));
				margin-bottom: 1.5em;
			}
			.page-header h1 {
				font-size: 2.2em;
				margin-bottom: 0.3em;
			}
			.page-header p {
				color: rgb(var(--gray));
				font-size: 1.05em;
				margin: 0;
			}
			.category-filters {
				display: flex;
				gap: 0.5rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-bottom: 2em;
			}
			.category-btn {
				padding: 0.4em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 20px;
				background: white;
				color: rgb(var(--gray));
				font-size: 0.9em;
				cursor: pointer;
				transition: all 0.2s ease;
				text-decoration: none;
			}
			.category-btn:hover, .category-btn.active {
				background: var(--accent);
				color: white;
				border-color: var(--accent);
			}
			ul {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li:first-child {
				grid-column: 1 / -1;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li.hidden {
				display: none;
			}
			.card {
				display: block;
				background: white;
				border-radius: 10px;
				overflow: hidden;
				border: 1px solid rgb(var(--gray-light));
				transition: box-shadow 0.2s, transform 0.15s;
			}
			.card:hover {
				box-shadow: 0 8px 24px rgba(0,0,0,0.08);
				transform: translateY(-3px);
			}
			.card img {
				width: 100%;
				height: 200px;
				object-fit: cover;
			}
			.card-body {
				padding: 1.2em;
			}
			.card-category {
				display: inline-block;
				padding: 0.15em 0.6em;
				background: var(--accent-light, #f0ece4);
				color: var(--accent, #8b6914);
				border-radius: 4px;
				font-size: 0.75em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 0.5em;
			}
			.card-title {
				font-size: 1.15em;
				font-weight: 700;
				line-height: 1.3;
				margin-bottom: 0.4em;
				color: rgb(var(--gray-dark));
			}
			.card-meta {
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.card-desc {
				font-size: 0.9em;
				color: rgb(var(--gray));
				margin-top: 0.5em;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.no-results {
				grid-column: 1 / -1;
				text-align: center;
				padding: 3em 1em;
				color: rgb(var(--gray));
				font-size: 1.1em;
				display: none;
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
				}
				.card img { height: 160px; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Insights</h1>
				<p>Clinical research, patient guides, and the latest developments in cancer treatment in China</p>
			</div>

			<div class="category-filters" id="filters">
				{categories.map((cat) => (
					<button class="category-btn" data-filter={cat}>{cat}</button>
				))}
			</div>

			<ul id="post-list">
				{posts.map((post) => (
					<li data-category={post.data.category}>
						<a href={`/blog/${post.id}/`} class="card">
							{post.data.heroImage && (
								<img src={post.data.heroImage} alt={post.data.title} />
							)}
							<div class="card-body">
								<span class="card-category">{post.data.category}</span>
								<h3 class="card-title">{post.data.title}</h3>
								<div class="card-meta">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<p class="card-desc">{post.data.description}</p>
							</div>
						</a>
					</li>
				))}
				<li class="no-results" id="no-results">No articles found in this category.</li>
			</ul>
		</main>
		<Footer />

		<script>
			function initFilters() {
				const filters = document.getElementById('filters');
				const list = document.getElementById('post-list');
				const noResults = document.getElementById('no-results');
				if (!filters || !list || !noResults) return;

				const buttons = filters.querySelectorAll('.category-btn');
				const items = list.querySelectorAll('li[data-category]');

				// Set "All" as active by default
				buttons.forEach(btn => {
					if (btn.getAttribute('data-filter') === 'All') {
						btn.classList.add('active');
					}
				});

				filters.addEventListener('click', (e) => {
					const btn = e.target.closest('.category-btn');
					if (!btn) return;

					const filter = btn.getAttribute('data-filter');

					// Update active button
					buttons.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');

					// Filter posts
					let visibleCount = 0;
					items.forEach(item => {
						const cat = item.getAttribute('data-category');
						if (filter === 'All' || cat === filter) {
							item.classList.remove('hidden');
							visibleCount++;
						} else {
							item.classList.add('hidden');
						}
					});

					// Show/hide no-results message
					noResults.style.display = visibleCount === 0 ? 'block' : 'none';
				});
			}

			// Run on page load
			initFilters();
			// Also re-init if Astro does a client-side navigation
			document.addEventListener('astro:page-load', initFilters);
		</script>
	</body>
</html>
